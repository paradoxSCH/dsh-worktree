{
  "name": "dsh-worktree",
  "version": "0.1.0-alpha.1",
  "description": "Durable Git worktree isolation and delivery for DeepSeek Harness subagents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paradoxSCH/dsh-worktree.git"
  },
  "bugs": {
    "url": "https://github.com/paradoxSCH/dsh-worktree/issues"
  },
  "homepage": "https://github.com/paradoxSCH/dsh-worktree#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "git-worktree",
    "agent",
    "subagent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run build",
    "pack:check": "pnpm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-subagent-in-process-driver": ">=0.1.0-rc.7 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
